{
  "compilerOptions": {
    "target": "ES2024",
    "declaration": true,
    "module": "node16",
    "lib": ["es2024"],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "moduleResolution": "node16",
    "typeRoots": ["./node_modules/@types"],
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "experimentalDecorators": true
  },
  "exclude": ["src/**/*.spec.ts"],
  "include": ["types/**/*.d.ts", "src/**/*"]
}
